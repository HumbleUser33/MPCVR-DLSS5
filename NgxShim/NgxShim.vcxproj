<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="ngxshim.cpp" />
  </ItemGroup>
  <ItemGroup>
    <None Include="ngxshim.def" />
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{6F2B9C41-6D3E-4B87-9E52-3A1C4D8E7B10}</ProjectGuid>
    <RootNamespace>NgxShim</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <ProjectName>NgxShim</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <Import Project="$(SolutionDir)\platform.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
    <Import Project="$(SolutionDir)\common.props" />
  </ImportGroup>
  <PropertyGroup>
    <!--
      The DLSS 5 NR snippet refuses any caller whose module path does not
      contain "nvngx.dll", so the file name is not cosmetic. It goes in a
      subfolder rather than beside the .ax so it cannot be picked up by
      unrelated NGX consumers living in the same player process.
    -->
    <TargetName>nvngx</TargetName>
    <TargetExt>.dll</TargetExt>
    <OutDir>$(SolutionDir)_bin\Filter_$(PlatformShortName)\dlss\</OutDir>
    <OutDir Condition="'$(Configuration)'=='Debug'">$(SolutionDir)_bin\Filter_$(PlatformShortName)_Debug\dlss\</OutDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <Link>
      <ModuleDefinitionFile>ngxshim.def</ModuleDefinitionFile>
      <!--
        Identical forwarder bodies get folded to one address by /OPT:ICF. That
        is harmless: the check is on the module the return address falls in,
        not on which export was called.
      -->
    </Link>
  </ItemDefinitionGroup>
  <!--
    Built for both platforms even though the snippet is x64 only: the shim is a
    few hundred bytes of forwarders, and the x86 filter simply never loads it.
    That is cheaper than carrying a per-platform exclusion.
  -->
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
